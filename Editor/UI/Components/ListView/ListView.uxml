<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container" style="flex-direction: column; flex-grow: 1; min-height: 32px;">
        <ui:VisualElement name="Center" style="flex-grow: 1;">
            <ui:VisualElement name="ItemHeader" style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="DragHandle" tooltip="Drag to reorder" />
                <ui:Foldout name="Fold-Foldout" text="" value="false" style="flex-grow: 0; flex-shrink: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
